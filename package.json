{
  "name": "colai-app-orders",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "cap:copy": "mkdir -p www && cp -R public/. www/ && if [ ! -f www/index.html ]; then printf '<!doctype html><html><head><meta charset=\"utf-8\"><title>ColAI</title></head><body><p>ColAI native shell.</p></body></html>' > www/index.html; fi",
    "cap:sync": "npm run cap:copy && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npm run cap:sync && npx cap run android",
    "cap:run:ios": "npm run cap:sync && npx cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@reduxjs/toolkit": "^2.2.3",
    "axios": "^1.13.4",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "greece-amka": "^1.0.0",
    "html5-qrcode": "^2.3.8",
    "next": "^16.1.1",
    "react": "19.0.0",
    "react-bootstrap": "^2.10.6",
    "react-dom": "19.0.0",
    "react-icons": "^5.5.0",
    "react-redux": "^9.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5"
  }
}
